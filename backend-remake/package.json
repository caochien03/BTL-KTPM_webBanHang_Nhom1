{
  "name": "bookstore-backend",
  "version": "1.0.0",
  "description": "Backend API for Online Bookstore Application",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon src/server.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "setup": "./setup.sh",
    "start:dev": "./start.sh",
    "init-admin": "curl -X POST http://localhost:3001/api/v1/admin/init",
    "seed-data": "curl -X POST http://localhost:3001/api/v1/admin/seed -H 'Authorization: Bearer TOKEN'",
    "seed:books": "node scripts/seedBooks.js",
    "seed:admin": "node scripts/createAdmin.js"
  },
  "keywords": ["bookstore", "api", "express", "mongodb", "typescript"],
  "author": "KTPM Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.16.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^24.0.3",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
